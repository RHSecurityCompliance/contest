require+:
  # virt library dependencies
  - libvirt-daemon
  - libvirt-daemon-driver-qemu
  - libvirt-daemon-driver-storage-core
  - qemu-kvm
  - libvirt-client
  - virt-install
  - nmap-ncat
  - rpm-build
  - createrepo
extra-hardware: |
    keyvalue = HVM=1
    hostrequire = memory>=6000
tag+:
  - snapshottable
adjust+:
  - when: arch != x86_64
    enabled: false
    because: run virtualization on x86_64 only
