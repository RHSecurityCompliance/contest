# Image builder needs to add the CUI profile to its allow list; osbuild-composer
# rejects it with "unsupported profile xccdf_org.ssgproject.content_profile_cui"
# https://redhat.atlassian.net/browse/HMS-11244
/hardening/image-builder/cui(_enhanced)?
/hardening/image-builder/uefi/cui(_enhanced)?
    status == 'error'

# the remediation copies /dev/shm mount options of the build environment into
# /etc/fstab, ie. 'inode64' from the CentOS Stream 10 image builder VM, which
# the RHEL-8 kernel doesn't support, so /dev/shm is not remounted with noexec
# https://github.com/ComplianceAsCode/content/issues/15332
/hardening/image-builder/.+/mount_option_dev_shm_noexec
    rhel == 8

# Image builder needs to add the IEC profile to its allow list; osbuild-composer
# rejects it with
# "unsupported profile xccdf_org.ssgproject.content_profile_iec_62443_sl1"
# "unsupported profile xccdf_org.ssgproject.content_profile_iec_62443_sl2"
# https://redhat.atlassian.net/browse/HMS-11606
/hardening/image-builder/iec_62443_sl1
/hardening/image-builder/iec_62443_sl2
    rhel == 9 and status == 'error'

