summary: Build and run Ansible collection profile roles
description: |-
    Builds the Ansible collection the same way the downstream RPM does
    (see the scap-security-guide spec) and then runs the collection role
    for the given profile inside a VM, followed by a scan of the
    remediated system.
test: $CONTEST_PYTHON -m lib.runtest ./test.py
environment+:
    PYTHONPATH: ../../..
duration: 3h
adjust+:
  # virt library dependencies are inherited from /hardening/ansible
  - when: arch != x86_64
    enabled: false
    because: we want to run virtualization on x86_64 only
  # The downstream collection is built only on RHEL (%{defined rhel} && !%{defined centos}).
  - when: distro == centos-stream-8 or distro == centos-stream-9 or distro == centos-stream-10
    enabled: false
    because: the RHEL hardening collection is built only for RHEL

/anssi_bp28_high:

/anssi_bp28_enhanced:
    tag+:
      - subset-profile

/anssi_bp28_intermediary:
    tag+:
      - subset-profile

/anssi_bp28_minimal:
    tag+:
      - subset-profile

/bsi:
    adjust+:
      - when: distro == rhel-8 or distro == centos-stream-8
        enabled: false
        because: The BSI profile is currently not on RHEL-8

/cis:

/cis_server_l1:
    tag+:
      - subset-profile

/cis_workstation_l2:

/cis_workstation_l1:
    tag+:
      - subset-profile

/cui:

/e8:

/hipaa:

/ism_o:
    tag+:
      - fips
    adjust+:
      - when: distro >= rhel-10 or distro >= centos-stream-10
        tag+:
          - subset-profile

/ism_o_secret:
    tag+:
      - fips
    adjust+:
      - when: distro >= rhel-10 or distro >= centos-stream-10
        tag+:
          - subset-profile
        continue: true
      - when: distro < rhel-10 or distro < centos-stream-10
        enabled: false
        because: ISM Official Secret is only present on RHEL-10+

/ism_o_top_secret:
    tag+:
      - fips
    adjust+:
      - when: distro < rhel-10 or distro < centos-stream-10
        enabled: false
        because: ISM Official Top Secret is only present on RHEL-10+

/ospp:
    tag+:
      - fips
    adjust+:
      - when: distro >= rhel-10
        enabled: false
        because: there is no OSPP profile on RHEL-10+

/pci-dss:

/stig:
    tag+:
      - fips

/stig_gui:
    adjust+:
      - enabled: false
        because: not supported without GUI, use stig instead

/ccn_advanced:
    adjust+:
      - when: distro != rhel-9 and distro != centos-stream-9
        enabled: false
        because: CCN profiles are only on RHEL-9

/ccn_intermediate:
    tag+:
      - subset-profile
    adjust+:
      - when: distro != rhel-9 and distro != centos-stream-9
        enabled: false
        because: CCN profiles are only on RHEL-9

/ccn_basic:
    tag+:
      - subset-profile
    adjust+:
      - when: distro != rhel-9 and distro != centos-stream-9
        enabled: false
        because: CCN profiles are only on RHEL-9
